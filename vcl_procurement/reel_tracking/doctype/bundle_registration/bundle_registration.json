  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Purchase Manager",
      "read": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Purchase User",
      "read": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Stock Manager",
      "read": 1,
      "report": 1,
      "print": 1
    }
  ]
