{
  "doctype": "DocType",
  "name": "Existing Stock Draft",
  "module": "Reel Tracking",
  "engine": "InnoDB",
  "allow_rename": 0,
  "track_changes": 1,
  "field_order": [
    "request_id",
    "company",
    "kind",
    "voucher_doctype",
    "voucher_name",
    "prepared_by",
    "request_json"
  ],
  "fields": [
    {
      "fieldname": "request_id",
      "label": "Request Id",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1
    },
    {
      "fieldname": "kind",
      "label": "Kind",
      "fieldtype": "Select",
      "options": "Opening\nTransfer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "voucher_doctype",
      "label": "Voucher Type",
      "fieldtype": "Link",
      "options": "DocType",
      "reqd": 1
    },
    {
      "fieldname": "voucher_name",
      "label": "Voucher",
      "fieldtype": "Dynamic Link",
      "options": "voucher_doctype",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "prepared_by",
      "label": "Prepared By",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "request_json",
      "label": "Request Json",
      "fieldtype": "Long Text",
      "reqd": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "autoname": "field:request_id",
  "naming_rule": "By fieldname",
  "permissions": [
    {
      "role": "Stock Manager",
      "read": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "print": 1
    }
  ]
